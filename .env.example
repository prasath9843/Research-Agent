# NVIDIA NIM Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
# Fast/Cheap Model for query planning, scoring, claim extraction
FAST_MODEL=meta/llama-3.2-11b-vision-instruct
# Strong/Larger Model for synthesis, contradiction detection
STRONG_MODEL=meta/llama-3.2-11b-vision-instruct

# Search Layer Priority & Settings
# Choices: ddgs, searxng, tavily
PRIMARY_SEARCH=ddgs
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=

# Pipeline Constraints
MAX_ROUNDS=3
MAX_SOURCES=20
DUPLICATE_CLAIM_THRESHOLD=0.70

# Database
DB_PATH=research_agent.db

# Production Authentication & Security
AUTH_SECRET=your-secure-jwt-auth-secret-key-min-32-chars

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://deepresearch-studio.onrender.com/api/auth/google/callback

# SMTP Email Dispatch Settings (Gmail, SendGrid, Resend, or AWS SES)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-smtp-email@gmail.com
